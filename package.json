{
  "name": "@esuyo/esuyo-opencode-session",
  "version": "2.0.8",
  "description": "OpenCode TUI sidebar showing token usage across a session and its subagents, plus live TPS/AVG/TTFT/GAP throughput in the prompt footer with optional JSONL stats logging.",
  "license": "MIT",
  "author": "Nick Braun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8perezm/esuyo-opencode-session.git"
  },
  "homepage": "https://github.com/8perezm/esuyo-opencode-session#readme",
  "bugs": {
    "url": "https://github.com/8perezm/esuyo-opencode-session/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tokens",
    "usage",
    "subagents",
    "tps",
    "throughput"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "default": "./tui.ts"
    }
  },
  "oc-plugin": [
    "tui"
  ],
  "files": [
    "tui.ts",
    "usage.ts",
    "tps.ts",
    "format.ts",
    "details-page.ts",
    "jsx.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload",
    "check": "npm run typecheck && npm run test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run pack:check"
  },
  "engines": {
    "opencode": ">=2.0.28 <3"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.28",
    "@opencode/client": "^2.0.28",
    "solid-js": "^1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.28",
    "@opencode/client": "2.0.28",
    "@opencode/theme": "2.0.28",
    "@opentui/core": "0.6.4",
    "@opentui/solid": "0.6.4",
    "solid-js": "^1.9.12",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.2"
  }
}
